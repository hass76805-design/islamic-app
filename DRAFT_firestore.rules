rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Validation Helpers (Strictly static type/size/key checks; no existing()/diff() inside helpers)
    function isValidUserSyncState(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'lastReadSurah',
          'lastReadAyah',
          'lastReadPage',
          'khatmaCompletedPagesCount',
          'preferredReciter',
          'preferredAdhan',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'lastReadSurah',
          'lastReadAyah',
          'lastReadPage',
          'khatmaCompletedPagesCount',
          'preferredReciter',
          'preferredAdhan',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.lastReadSurah is int
        && data.lastReadSurah >= 1
        && data.lastReadSurah <= 114
        && data.lastReadAyah is int
        && data.lastReadAyah >= 1
        && data.lastReadAyah <= 286
        && data.lastReadPage is int
        && data.lastReadPage >= 1
        && data.lastReadPage <= 604
        && data.khatmaCompletedPagesCount is int
        && data.khatmaCompletedPagesCount >= 0
        && data.khatmaCompletedPagesCount <= 604
        && data.preferredReciter is string
        && data.preferredReciter.size() >= 1
        && data.preferredReciter.size() <= 40
        && data.preferredAdhan is string
        && data.preferredAdhan.size() >= 1
        && data.preferredAdhan.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemorizationResult(data, userId) {
      return data.keys().hasAll([
          'uid',
          'surahNumber',
          'surahName',
          'ayahNumber',
          'score',
          'mistakesCount',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'surahNumber',
          'surahName',
          'ayahNumber',
          'score',
          'mistakesCount',
          'createdAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.surahNumber is int
        && data.surahNumber >= 1
        && data.surahNumber <= 114
        && data.surahName is string
        && data.surahName.size() >= 1
        && data.surahName.size() <= 80
        && data.ayahNumber is int
        && data.ayahNumber >= 1
        && data.ayahNumber <= 286
        && data.score is int
        && data.score >= 0
        && data.score <= 100
        && data.mistakesCount is int
        && data.mistakesCount >= 0
        && data.mistakesCount <= 5000
        && data.createdAt is timestamp;
    }

    function isValidQuranBookmark(data, userId) {
      return data.keys().hasAll([
          'uid',
          'page',
          'surahNumber',
          'surahName',
          'ayahNumber',
          'snippet',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'page',
          'surahNumber',
          'surahName',
          'ayahNumber',
          'snippet',
          'createdAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.page is int
        && data.page >= 1
        && data.page <= 604
        && data.surahNumber is int
        && data.surahNumber >= 1
        && data.surahNumber <= 114
        && data.surahName is string
        && data.surahName.size() >= 1
        && data.surahName.size() <= 80
        && data.ayahNumber is int
        && data.ayahNumber >= 1
        && data.ayahNumber <= 286
        && data.snippet is string
        && data.snippet.size() >= 1
        && data.snippet.size() <= 200
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserSyncState(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserSyncState(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'lastReadSurah',
            'lastReadAyah',
            'lastReadPage',
            'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'khatmaCompletedPagesCount',
            'preferredReciter',
            'preferredAdhan',
            'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'lastReadSurah',
            'lastReadAyah',
            'lastReadPage',
            'khatmaCompletedPagesCount',
            'preferredReciter',
            'preferredAdhan',
            'updatedAt'
          ])
        );

      allow delete: if isSignedIn() && isValidId(userId) && isOwner(userId);

      match /testResults/{resultId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(resultId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().uid == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(userId)
          && isValidId(resultId)
          && isOwner(userId)
          && isValidMemorizationResult(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(resultId) && isOwner(userId);
      }

      match /bookmarks/{bookmarkId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(bookmarkId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().uid == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(userId)
          && isValidId(bookmarkId)
          && isOwner(userId)
          && isValidQuranBookmark(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(bookmarkId) && isOwner(userId);
      }
    }
  }
}
